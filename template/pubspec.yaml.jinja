name: {{ package_name }}
{# Quote + escape: an unquoted plain scalar breaks on ": " and other YAML
   metacharacters in the description (e.g. "messaging: 1:1"), which then
   kills the post-generation `flutter create` tasks. -#}
description: "{{ description | replace('\\', '\\\\') | replace('"', '\\"') }}"

version: 1.0.0
license: {{ license }}
repository: https://github.com/{{ github_repo }}
homepage: https://github.com/{{ github_repo }}
issue_tracker: https://github.com/{{ github_repo }}/issues

environment:
  sdk: {{ dart_sdk_version }}

dependencies:
{%- set _frb = frb_version | replace("^", "") | trim %}
{%- set _frb_parts = _frb.split(".") %}
  # One version, written as a range. `frb_generated.dart` records the codegen
  # version and the runtime asserts it equals its own with `==`, so anything a
  # range admits except this exact version throws on init. `>=X.Y.Z <X.Y.Z+1`
  # admits only X.Y.Z — but unlike the bare `X.Y.Z` form it does not trip pub's
  # "should allow more than one version" warning, and `dart pub publish` exits
  # 65 on any warning, which would make the package unreleasable. The caret is
  # stripped rather than trusted absent, so this, FRB_CODEGEN_VERSION and the
  # `=` pin in Cargo.toml stay in step whatever `frb_version` is answered with.
  flutter_rust_bridge: ">={{ _frb }} <{{ _frb_parts[0] }}.{{ _frb_parts[1] }}.{{ _frb_parts[2] | int + 1 }}"
  # SHA256 verification for native library downloads
  crypto: ^3.0.7
  # Build hooks for automatic native library download. Left on the caret
  # deliberately: these define the protocol hook/build.dart implements, and the
  # SDK is the other half of it — capping them below what the pinned Flutter
  # expects breaks the hook at a consumer's build, which is worse than the drift.
  # Majors (hooks 2.x, code_assets 2.x) are a deliberate migration, not a bump.
  hooks: ^1.0.0
  code_assets: ^1.0.0
  # Data-carrying enums/structs in the FRB API are generated as freezed
  # sealed classes
  freezed_annotation: ^3.0.0

dev_dependencies:
  # Capped to one minor line, not because 6.1 is bad but because
  # `make analyze ARGS="--fatal-infos"` makes every newly-added info-level lint
  # a build failure, pubspec.lock is not committed, and CI re-resolves on every
  # run — so a minor published upstream reddens main with nobody having changed
  # a line. Within the range, patches still arrive. The bump then comes as a
  # Dependabot pull request the matrix actually evaluates, which is the review
  # this deserves; widen the upper bound there once it is green.
  lints: ">=6.1.0 <6.2.0"
  test: ^1.24.0
  coverage: ^1.15.0
  # Required by flutter_rust_bridge_codegen. Feeds codegen rather than the
  # runtime, so a change here shows up as a diff in the committed bindings and
  # not as a failing assert — the update workflow's `bindings=changed` tripwire
  # is what surfaces it.
  ffigen: ^20.1.1
  # Required by the FRB-generated freezed sealed classes. Upper bound:
  # 3.2.6-dev prereleases fail flutter_rust_bridge_codegen's dependency
  # version check.
  freezed: ">=3.0.0 <3.2.6"
  # Upper bound: build_runner >=2.6 AOT-compiles builders via `dart compile`,
  # which rejects packages using native build hooks (hook/build.dart).
  build_runner: ">=2.4.0 <2.6.0"

platforms:
  android:
  ios:
  linux:
  macos:
  windows:
{% if enable_web %}  web:
{% endif %}
topics:
{%- for topic in topics.split(',') | map('trim') %}
  - {{ topic }}
{%- endfor %}
