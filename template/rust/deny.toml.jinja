{%- import "macros/upstream.jinja" as upstream with context -%}
# cargo-deny configuration for {{ crate_name }}.
#
# Runs in CI (see .github/workflows/test-reusable.yml) and locally via
# `make rust-deny`. Complements `cargo audit`:
#   - advisories: fail on known RustSec vulnerabilities
#   - licenses:   only allow licenses compatible with this package
#   - bans:       flag duplicate/wildcard dependencies
#   - sources:    only permit crates.io and explicitly-listed git repositories
#
# Schema reference: https://embarkstudios.github.io/cargo-deny/

[graph]
targets = []
all-features = false

[advisories]
version = 2
# A yanked version is one its own publisher withdrew. cargo-deny only warns
# about one by default, and a warning in a job that passes reaches nobody:
# `inout` 0.2.3, yanked for losing a buffer check its unsafe code relies on,
# sat in a generated project's lockfile for six days with this job green. As
# an error it fails the job until the lockfile moves past it, through the next
# Dependabot cargo pull request or by hand with the `cargo update -p` its
# message names. `make rust-update` does not do it: it re-resolves the
# workspace's own requirements and leaves such a crate where it is. A version
# with no fixed release yet can be accepted under `ignore` below, as
# `{ crate = "name@version", reason = "..." }`.
yanked = "deny"
# Add advisory IDs here (each with a justification comment) only to consciously
# accept a risk that cannot yet be remediated, e.g. an unmaintained build-time
# dependency pulled transitively by an upstream crate with no available upgrade.
#
# Two things about this list that are easy to get wrong:
#
#   - An entry that stops matching is reported as `advisory-not-detected`. That
#     warning is the signal to DELETE the entry, not to keep it in case the
#     crate comes back: an ignore nobody can trigger is indistinguishable from
#     one that is quietly covering a second advisory it was never reviewed for.
#     Re-check the whole list on every upstream bump — empty it, run
#     `make rust-deny`, and re-add only what fires again, with a fresh reason.
#
#   - This list and `.cargo/audit.toml` are not interchangeable. cargo-deny
#     also reports *unmaintained* advisories, which `cargo audit` does not fail
#     on, so an entry here is often one `make rust-audit` never needed.
ignore = []

[licenses]
version = 2
confidence-threshold = 0.9
# The project's own license plus the permissive licenses commonly found in a
# Rust dependency tree. Extend this list if `cargo deny check licenses` reports
# a license it did not encounter (that is expected the first time you build).
#
# Rendered as one de-duplicated list rather than "own license, then the common
# set": three of the four licenses this template offers (MIT, Apache-2.0,
# BSD-3-Clause) are already in that set, so the straightforward form emits them
# twice and cargo-deny reports the duplicate against this file. AGPL-3.0 is the
# one that genuinely adds entries, which is why it carries the two SPDX
# spellings the tree actually uses.
{%- set _allowed_licenses = [license]
    + (["AGPL-3.0-only", "AGPL-3.0-or-later"] if license == "AGPL-3.0" else [])
    + ["MIT", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BSD-2-Clause",
       "BSD-3-Clause", "ISC", "Zlib", "MPL-2.0", "Unicode-3.0",
       "Unicode-DFS-2016", "CC0-1.0", "0BSD"] %}
allow = [
{%- for _license in _allowed_licenses | unique %}
    "{{ _license }}",
{%- endfor %}
]
exceptions = []

[bans]
# Diamond dependencies are common in crypto/WASM trees, so duplicates warn.
multiple-versions = "warn"
{%- if upstream_crates and upstream.source() == 'crates_io' %}
# Every upstream crate comes from crates.io with a version requirement, and so
# does everything it pulls in — crates.io accepts no dependency that is only a
# git one — so a wildcard here is a mistake rather than a pin, and it fails. A
# path dependency of this unpublished crate is not one; a git dependency you add
# needs a `version` beside its `git`, as well as an `allow-git` entry below.
wildcards = "deny"
allow-wildcard-paths = true
{%- else %}
# Git dependencies pinned by tag (with no version requirement) are reported as
# wildcards, so wildcards warn rather than fail; a genuinely sloppy `"*"`
# crates.io dependency still shows up in the log.
wildcards = "warn"
{%- endif %}
allow = []
deny = []

[sources]
unknown-registry = "deny"
unknown-git = "deny"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
allow-git = [
{%- if upstream.git_url() %}
    # Upstream crate repository (pinned by tag in Cargo.toml, by commit in Cargo.lock).
    "{{ upstream.git_url() }}",
{%- elif upstream_crates %}
    # None for the upstream crates: they come from crates.io
    # (upstream_source=crates_io), which allow-registry above already admits.
{%- endif %}
    # Add any additional git dependency repositories here. Transitive git deps
    # (a crate the upstream itself pulls from git) must be listed explicitly or
    # `cargo deny check sources` will fail.
]
