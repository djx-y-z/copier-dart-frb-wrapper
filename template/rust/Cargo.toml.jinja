[package]
name = "{{ crate_name }}"
version = "1.0.0"
edition = "{{ rust_edition }}"
rust-version = "{{ rust_version }}"
description = "{{ description | replace('\\', '\\\\') | replace('"', '\\"') }}"
repository = "https://github.com/{{ github_repo }}"
license = "{{ license }}"
publish = false

[lib]
name = "{{ crate_name }}"
{%- if enable_fuzzing %}
# rlib is required so the fuzz crate (rust/fuzz) can link against this crate.
crate-type = ["cdylib", "staticlib", "rlib"]
{%- else %}
crate-type = ["cdylib", "staticlib"]
{%- endif %}

[dependencies]
flutter_rust_bridge = "={{ frb_version | replace('^', '') }}"
thiserror = "2.0"
log = "0.4"
{%- if upstream_crates %}
{%- for crate in upstream_crates.split(',') %}
{{ crate | trim }} = { git = "https://github.com/{{ native_repo }}", tag = "{{ upstream_version }}" }
{%- endfor %}
{%- endif %}
{%- if enable_web %}

[target.'cfg(target_arch = "wasm32")'.dependencies]
# getrandom refuses to compile for wasm32-unknown-unknown until its browser
# backend is selected by name, and three majors coexist in a modern Rust crypto
# graph. Cargo unions features per package version and per target, so declaring
# each here is what turns the backend on for every crate that reaches it on the
# Web, and changes nothing for the native builds.
#
# 0.4 is the one that is easy to miss. The RustCrypto stack reaches it through
# aead 0.6 -> crypto-common, which declares it with NO target cfg, so it is
# compiled for wasm32 as well — and a `--cfg getrandom_backend="wasm_js"` in
# .cargo/config.toml does NOT cover it: 0.4 does not recognise that value and
# selects its backend from the feature alone.
#
# Getting it wrong is loud rather than silently weak: getrandom `compile_error!`s
# when it has no backend for this target, so `make build-web` fails closed.
# If one of these is genuinely unreachable, `cargo tree --target
# wasm32-unknown-unknown -i getrandom@<version>` says so — the declaration is
# then the only thing holding it in the graph and can be dropped.
getrandom_02 = { package = "getrandom", version = "0.2", features = ["js"] }
getrandom = { version = "0.3", features = ["wasm_js"] }
getrandom_04 = { package = "getrandom", version = "0.4", features = ["wasm_js"] }
wasm-bindgen = "0.2"
wasm-bindgen-futures = "0.4"
js-sys = "0.3"
web-sys = { version = "0.3", features = ["console", "Window", "Performance"] }

[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
# The browser harness `make test-web` drives. Target-gated so a native
# `cargo test` does not build a browser harness it can never run.
#
# ⚠ This is NOT visible to the third-party notices gate, and does not need to
# be: `make third-party-notices` runs `cargo tree --edges normal,build`, which
# excludes EVERY dev-dependency on every target, gated or not.
wasm-bindgen-test = "0.3"
{%- endif %}

# ⚠ The absence of a `panic` key here is load-bearing. Adding
# `panic = "abort"` would trade a small binary saving for skipping unwinding
# altogether, and unwinding is what runs `Drop` — so every zeroize-on-Drop in
# this crate would silently stop happening on the one path where it matters
# most, a failure in the middle of an operation holding key material. Nothing
# would fail; the wipe would just not occur. The same applies to
# `-Cpanic=abort` in RUSTFLAGS, which bypasses this file entirely.
#
# Enforced by `release_profile_must_not_abort_on_panic` in `src/utils.rs`,
# which reads this file rather than the profile it runs under: Cargo forces
# unwind for `test`/`bench`, so no running test can observe the setting that
# actually ships. It rejects the key in either TOML string form and, because an
# exact section match is a thing TOML gives several ways around, any
# non-comment line here that names both `panic` and `abort`.
#
# It is a native-target statement only: `wasm32-unknown-unknown` aborts on
# panic by default (`rustc --print cfg --target wasm32-unknown-unknown` says
# `panic="abort"`), and no profile key changes that — a panic traps the module,
# destructors do not run, and anything held in linear memory stays there until
# the page is reloaded. Say so in SECURITY.md rather than assuming the profile
# covers it.
[profile.release]
lto = true
opt-level = "z"
strip = true
{%- if enable_web %}

[package.metadata.wasm-pack.profile.release]
wasm-opt = ["-O4", "--enable-bulk-memory", "--enable-nontrapping-float-to-int"]
{%- endif %}

# Turn silent integer wraparound into a deterministic panic — but ONLY for this
# crate's own code. Applying overflow-checks tree-wide would change the release
# arithmetic of audited upstream dependencies, some of which rely on wrapping.
[profile.release.package.{{ crate_name }}]
overflow-checks = true

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ["cfg(frb_expand)"] }
# No unsafe in hand-written code; the FRB-generated module opts out explicitly
# via #[allow(unsafe_code)] in lib.rs.
unsafe_code = "deny"
